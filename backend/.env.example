# ============ REQUIRED ============
GROQ_API_KEY=
TAVILY_API_KEY=            # or set SEARCH_PROVIDER=brave|serpapi and the matching key below

# ============ MODELS ============
# Groq retires models often. List what YOUR key can use:
#   python -c "import httpx,os; from dotenv import load_dotenv; load_dotenv(); r=httpx.get('https://api.groq.com/openai/v1/models',headers={'Authorization':'Bearer '+os.environ['GROQ_API_KEY']}); print(sorted(m['id'] for m in r.json()['data']))"
PLANNER_MODEL=openai/gpt-oss-120b        # root DeepAgent (needs reliable tool calling)
WRITER_MODEL=openai/gpt-oss-120b         # report writing
FAST_MODEL=openai/gpt-oss-20b            # extraction, compression, diff judging, summaries

# ============ SEARCH ============
SEARCH_PROVIDER=tavily     # tavily | brave | serpapi
BRAVE_API_KEY=
SERPAPI_API_KEY=
RESULTS_PER_SUBTASK=5

# ============ CONTEXT ENGINEERING KNOBS ============
MAX_PARALLEL_SUBTASKS=6
EVIDENCE_TOKEN_BUDGET=6000
ENTITY_CHARS_PER_SOURCE=1800     # query-relevant excerpt size given to the extractor per source
CLAIMS_PER_SOURCE=4
MAX_LLM_CONCURRENCY=2            # Groq free tier is rate-limited; raise on paid tiers

# ============ PLANNER ============
PLANNER_MODE=deepagent           # deepagent | direct  (direct = plain LLM planning, skips DeepAgents; for debugging)

# ============ FACT CHECK ============
FACTCHECK_THRESHOLD=0.85
FACTCHECK_SAMPLE_RATE=0.2
FACTCHECK_MIN_CLAIMS=5

# ============ EMBEDDINGS / VECTOR STORE ============
EMBEDDINGS_BACKEND=fastembed     # fastembed | hash (hash = offline test fallback, NOT for real use)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_PATH=data/qdrant          # local on-disk Qdrant (or :memory:)
QDRANT_URL=                      # set to use a Qdrant server instead, e.g. http://localhost:6333

# ============ APP ============
DATA_DIR=data
JWT_SECRET=change-me-in-real-use
SHARE_TTL_DAYS=7
FRONTEND_URL=http://localhost:3000
DEMO_INTERVAL_SECONDS=0          # >0 = run every watchlist item every N seconds (for the demo video)

# ============ OPTIONAL: reasoning models (gpt-oss) ============
REASONING_EFFORT=low             # low | medium | high; reasoning models spend output tokens on hidden thinking
LLM_MAX_TOKENS=3000              # output limit per call (auto-doubled once if a reply comes back empty)
